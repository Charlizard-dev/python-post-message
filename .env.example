# Copy to .env and fill in the platforms you want to enable.
# A platform with missing credentials is reported as "failed: not configured"
# and never blocks the others.

# --- General ---
LOG_LEVEL=INFO
HTTP_TIMEOUT=15
PLATFORM_TIMEOUT=30
MAX_RETRIES=2
VERIFY_PUBLIC_ACCESS=true

# --- Telegraph (no sign-up needed; account auto-created if token empty) ---
TELEGRAPH_ENABLED=true
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=Automated Posting

# --- Mastodon: Preferences > Development > New application (scope: write:statuses) ---
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky: Settings > Privacy and security > App passwords ---
BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- Telegram: create bot via @BotFather, add it as admin of a public channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# --- Discord: Server Settings > Integrations > Webhooks > New Webhook ---
DISCORD_WEBHOOK_URL=

# --- GitHub: fine-grained token with "Gists: Read and write" ---
GITHUB_TOKEN=
